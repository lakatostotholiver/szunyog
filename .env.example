# Másold le ezt a fájlt .env névvel, és töltsd ki az értékeket.
# A .env fájl soha ne kerüljön fel GitHubra!

# Groq API kulcs – a BékaBot AI chatbothoz szükséges
# Ingyenes kulcs igényelhető: https://console.groq.com
GROQ_API_KEY=ide_ird_a_groq_api_kulcsot

# Admin felület (/admin-belepes) – egyetlen közös jelszó, nincs Firebase,
# nincs személyenkénti fiók. Csak szerveroldalon használt, NE legyen VITE_ prefix.
# Éles szerveren állítsd be, majd indítsd újra a szervert.
DIKTALAS_PASSWORD=ide_ird_a_kozos_jelszot

# Hova mentse a gócpont-kutatás bejegyzéseket a szerver (JSON fájl). Ha üresen
# hagyod, a projekt mappáján KÍVÜL, egy szülőmappában tárolja – így egy friss
# GitHub-klónozás sem törli el az adatokat. Éles szerveren érdemes explicit,
# állandó elérési utat megadni.
#
# FONTOS: Vercelen ez NEM tartós – a Vercel serverless függvényei csak
# ideiglenes fájlrendszert engednek írni, ami minden hívás/redeploy után
# elveszhet. Az admin felület (gócpont-kutatások rögzítése/szerkesztése)
# ezért egy tartós fájlrendszerű, saját szerveren (VPS, node server.js)
# fusson, ne kizárólag Vercelen.
DIKTALAS_DATA_DIR=
