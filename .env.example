# Másold le ezt a fájlt .env névvel, és töltsd ki az értékeket.
# A .env fájl soha ne kerüljön fel GitHubra!

# Groq API kulcs – a BékaBot AI chatbothoz szükséges
# Ingyenes kulcs igényelhető: https://console.groq.com
GROQ_API_KEY=ide_ird_a_groq_api_kulcsot

# Firebase – kolléga bejelentkezés + riportok (Auth, Firestore, Storage)
# https://console.firebase.google.com – Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gócpont-kutatás diktálása (/diktalas) – közös jelszó, nincs hozzá Firebase.
# Csak szerveroldalon használt, NE legyen VITE_ prefix. Éles szerveren állítsd be, majd indítsd újra a szervert.
DIKTALAS_PASSWORD=ide_ird_a_kozos_jelszot

# Hova mentse a /diktalas bejegyzéseket a szerver (JSON fájl). Ha üresen hagyod,
# a projekt mappáján KÍVÜL, egy szülőmappában tárolja – így egy friss GitHub-klónozás
# sem törli el az adatokat. Éles szerveren érdemes explicit, állandó elérési utat megadni.
DIKTALAS_DATA_DIR=

# Firebase Admin SDK – a kolléga-meghívás (api/colleagues/invite.js) és az
# Authorization: Bearer <idToken> ellenőrzés (api/_lib/verifyAuth.js) ezzel
# tudja szerveroldalon is ellenőrizni/kezelni a Firebase usereket.
# Firebase konzol → Project settings → Service accounts → Generate new private key,
# majd a letöltött JSON teljes tartalmát base64-kódold egyetlen sorba:
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#   macOS/Linux:        base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_B64=

# Resend – riport-értesítő és kolléga-meghívó e-mailek küldéséhez.
# https://resend.com – ingyenes API kulcs. Ha üresen hagyod, az email küldés
# csendben kimarad (a funkció maga nem hasal el).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
